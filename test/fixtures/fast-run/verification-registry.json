      "command": ["node", "scripts/observe.mjs"]
    },
    {
      "id": "false-green",
      "role": "test",
      "requiredForFast": false,
      "command": ["node", "scripts/false-green.mjs"]
    },
    {
      "id": "leak-raw-log",
      "role": "implementation",
      "command": ["node", "scripts/leak-raw-log.mjs"]
    },
    {
      "id": "unsafe-quality-review",
      "role": "quality-review",
      "command": ["node", "scripts/unsafe-quality-review.mjs"]
    },
    {
      "id": "commit-outside-lease",
      "role": "implementation",
      "command": ["node", "scripts/commit-outside-lease.mjs"]
