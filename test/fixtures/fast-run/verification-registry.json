      "role": "implementation",
      "command": ["node", "scripts/apply-change.mjs"]
    },
    {
      "id": "apply-cross-file-change",
      "role": "implementation",
      "command": ["node", "scripts/apply-cross-file-change.mjs"]
    },
    {
      "id": "focused-message-test",
      "role": "focused-test",
      "command": ["node", "--test", "test/message.test.mjs"]
    },
    {
      "id": "focused-cross-file-test",
      "role": "focused-test",
      "command": ["node", "--test", "test/cross-file.test.mjs"]
    },
    {
      "id": "git-status-focused",
      "role": "focused-test",
      "command": ["node", "scripts/check-git-status.mjs"]
    },
    {
      "id": "quality-review",
      "role": "quality-review",
      "command": ["node", "scripts/quality-review.mjs"]
    },
    {
      "id": "full-test",
