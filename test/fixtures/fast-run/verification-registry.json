    },
    {
      "id": "commit-then-reset",
      "role": "implementation",
      "command": ["node", "scripts/commit-then-reset.mjs"]
    },
    {
      "id": "mutate-main-ref",
      "role": "implementation",
      "command": ["node", "scripts/mutate-main-ref.mjs"]
    },
    {
      "id": "dirty-integration-worktree",
      "role": "implementation",
      "command": ["node", "scripts/dirty-integration-worktree.mjs"]
    },
    {
      "id": "delete-protected-ref-and-dirty-integration",
